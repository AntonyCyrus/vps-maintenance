#!/usr/bin/env bash
set -Eeuo pipefail

# 每日只安装 Debian 官方安全更新。
# 在常规更新日和全面升级日主动退出，避免同一天重复升级。

export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=l
export NEEDRESTART_SUSPEND=1

readonly LOCK_FILE="/run/lock/vps-maintenance.lock"
readonly LOCK_WAIT_SECONDS=21600
readonly DAY_EAST8="$(TZ=Asia/Shanghai date +%d)"

log() {
    printf '[daily-security] %s\n' "$*"
}

case "$DAY_EAST8" in
    04|08|11|18|22|25)
        log "今天由更全面的固定日期更新任务覆盖，跳过每日安全更新。"
        exit 0
        ;;
esac

exec 9>"$LOCK_FILE"
if ! flock --wait "$LOCK_WAIT_SECONDS" 9; then
    log "等待维护锁超时，未执行更新。"
    exit 1
fi

log "开始刷新 APT 索引。"
apt-get -o Acquire::Retries=3 update

log "开始安装 Debian Security 更新。"
unattended-upgrade --verbose

log "统一重启仍在使用旧共享库的后台服务。"
unset NEEDRESTART_SUSPEND
NEEDRESTART_MODE=a needrestart -r a

log "每日安全更新完成。"

